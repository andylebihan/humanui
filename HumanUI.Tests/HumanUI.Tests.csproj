<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <RootNamespace>HumanUI.Tests</RootNamespace>
    <AssemblyName>HumanUI.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- Grasshopper.targets auto-strips Grasshopper.dll/GH_IO.dll from the output. The .gha
         must not redistribute them, but the test host needs them at runtime. -->
    <ShouldRemoveRhinoReferences>False</ShouldRemoveRhinoReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <!-- Tests need Grasshopper/RhinoCommon (which also provides Eto.dll) at runtime. -->
    <PackageReference Include="Grasshopper" Version="8.27.26019.16021" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HumanUI\HumanUI\HumanUI.csproj" />
  </ItemGroup>

  <!-- ContractSnapshotTests + SnapshotComparison stay disabled until the
       contract-baseline.json is regenerated against the current component
       set (the original baseline was captured pre-migration). ComponentSmoke
       comes back online — every Create*/Set* component is now ported. -->
  <ItemGroup>
    <Compile Remove="ContractSnapshotTests.cs" />
    <Compile Remove="SnapshotComparison.cs" />
  </ItemGroup>

</Project>
