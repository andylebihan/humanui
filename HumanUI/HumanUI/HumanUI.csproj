<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net7.0-windows so the System.Windows.Forms types Grasshopper exposes in its
         menu APIs (ToolStripDropDown etc.) resolve at compile time. The .gha is still
         loadable by Rhino on Mac because we don't actually invoke any Windows-only
         runtime APIs through it - UseWindowsForms is enabled only for the reference
         assemblies, not for the WinForms runtime hosting. -->
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HumanUI</RootNamespace>
    <AssemblyName>HumanUI</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);NU1701;CS0168;CS0219</NoWarn>
    <FallbackCulture>en-US</FallbackCulture>
  </PropertyGroup>

  <ItemGroup>
    <!-- Grasshopper transitively pulls in RhinoCommon, which bundles the McNeel-signed
         Eto.dll (PublicKeyToken=552281e97c755530). We reference that Eto directly rather
         than the unsigned one from the Eto.Forms NuGet, so all assemblies in the load
         graph agree on a single Eto identity. -->
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />
    <!-- Needed at build time because Properties/Resources.resx contains image entries
         (component icons) that get compiled into the embedded .resources via the new
         System.Resources.Extensions serializer. -->
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HumanUIBaseApp\HumanUIBaseApp\HumanUIBaseApp.csproj" />
  </ItemGroup>

  <!--
    Phase 0 of the Eto migration: only LaunchWindow + AddElements are ported. Every other
    component / custom type / deprecated file is excluded from compile to keep the project
    green while the rest of the surface is rebuilt. As each component is ported in phases
    1-5 the corresponding <Compile Remove> entry is dropped. Upgraders/ stays in: those are
    pure GUID-mapping records and have no UI-toolkit dependency.

    HumanUI.Tests/SnapshotComparison.AcceptedRemovals tracks the temporarily-removed
    components against master so the regression test still passes.
  -->
  <ItemGroup>
    <!-- Upgraders that reference components still excluded in Phase 2 are themselves
         excluded for now; the rest (Pulldown, Slider, AdjustElementAppearance,
         RestoreState, TextBox) handle pure GH_UpgradeUtil swap-by-GUID so they compile
         cleanly without needing their target component types alive at compile time. -->
    <Compile Remove="Upgraders\Upgrade_ValueListener.cs" />
    <Compile Remove="Upgraders\Upgrade_SetWindowPropertiesComponent.cs" />
    <Compile Remove="Upgraders\Upgrade_SetTabs.cs" />
    <Compile Remove="Upgraders\Upgrade_GridComponent.cs" />
    <Compile Remove="Components\Testing - Troubleshooting\**\*.cs" />
    <Compile Remove="Components\UI Containers\**\*.cs" />
    <Compile Remove="Components\UI Elements\**\*.cs" />
    <Compile Remove="Components\UI Graphs\**\*.cs" />
    <Compile Remove="Components\UI Output\**\*.cs" />
    <!-- Phase 1 (Tier-1 elements): each ported component re-included individually as the
         corresponding Eto reimplementation lands. -->
    <Compile Include="Components\UI Containers\CreateStack_Component.cs" />
    <Compile Include="Components\UI Containers\CreateSimpleGrid_Component.cs" />
    <Compile Include="Components\UI Containers\CreateBorder_Component.cs" />
    <Compile Include="Components\UI Containers\CreateScrollViewer_Component.cs" />
    <Compile Include="Components\UI Containers\CreateExpander_Component.cs" />
    <Compile Include="Components\UI Containers\CreateWrapPanel_Component.cs" />
    <Compile Include="Components\UI Containers\CreateViewBox_Component.cs" />
    <Compile Include="Components\UI Containers\TabContainer_Component.cs" />
    <Compile Include="Components\UI Elements\CreateLabel_Component.cs" />
    <Compile Include="Components\UI Elements\CreateTextBlock_Component.cs" />
    <Compile Include="Components\UI Elements\CreateCheckBox_Component.cs" />
    <Compile Include="Components\UI Elements\CreateButton_Component.cs" />
    <Compile Include="Components\UI Elements\CreateTextBox_Component.cs" />
    <Compile Include="Components\UI Elements\CreateListBox_Component.cs" />
    <Compile Include="Components\UI Elements\CreatePullDown_Component.cs" />
    <Compile Include="Components\UI Elements\CreateSlider_Component.cs" />
    <Compile Include="Components\UI Elements\CreateImage_Component.cs" />
    <Compile Include="Components\UI Elements\CreateColorPicker_Component.cs" />
    <Compile Include="Components\UI Elements\CreateShape_Component.cs" />
    <Compile Include="Components\UI Elements\Create3DView_Component.cs" />
    <Compile Include="Components\UI Output\SetLabel_Component.cs" />
    <Compile Include="Components\UI Output\SetTextBlock_Component.cs" />
    <Compile Include="Components\UI Output\SetCheckBox_Component.cs" />
    <Compile Include="Components\UI Output\SetButton_Component.cs" />
    <Compile Include="Components\UI Output\SetTextBox_Component.cs" />
    <Compile Include="Components\UI Output\SetList_Component.cs" />
    <Compile Include="Components\UI Output\SetSlider_Component.cs" />
    <Compile Include="Components\UI Output\SetImage_Component.cs" />
    <Compile Include="Components\UI Output\SetColorPicker_Component.cs" />
    <Compile Include="Components\UI Output\SetShape_Component.cs" />
    <Compile Include="Components\UI Output\Set3DView_Component.cs" />
    <!-- Phase 3: specialized elements + button variants. Each include here pairs
         with a corresponding port from WPF/MahApps to Eto.Forms. The Include
         clauses come after the bulk Remove so SDK-style item ordering keeps them
         in the compile set. -->
    <Compile Include="Components\UI Elements\CreateSeparator_Component.cs" />
    <Compile Include="Components\UI Elements\CreateRadioButton_Component.cs" />
    <Compile Include="Components\UI Elements\CreateToggle_Component.cs" />
    <Compile Include="Components\UI Elements\CreateTooltip_Component.cs" />
    <Compile Include="Components\UI Elements\CreateFilePicker_Component.cs" />
    <Compile Include="Components\UI Elements\CreateRhinoCmdButton_Component.cs" />
    <Compile Include="Components\UI Elements\CreateRhinoPickButton.cs" />
    <Compile Include="Components\UI Elements\CreateTrueOnlyButton.cs" />
    <Compile Include="Components\UI Elements\CreateBrowser_Component.cs" />
    <Compile Include="Components\UI Output\SetBrowser_Component.cs" />
    <!-- Phase 4: real ports for Checklist, Grid, Range Slider, DataTable, Markdown Viewer. -->
    <Compile Include="Components\UI Containers\CreateGrid_Component.cs" />
    <Compile Include="Components\UI Elements\CreateCheckList_Component.cs" />
    <Compile Include="Components\UI Elements\CreateRangeSlider.cs" />
    <Compile Include="Components\UI Elements\CreateDataTable_Component.cs" />
    <Compile Include="Components\UI Elements\Create_MarkdownViewer_Component.cs" />
    <Compile Include="Components\UI Output\SetChecklist_Component.cs" />
    <Compile Include="Components\UI Output\SetDataTable_Component.cs" />
    <!-- Custom Types\HUI_RangeSlider.cs auto-included by SDK (not in any Remove). -->
    <!-- Custom Types\MarkdownViewer.cs is explicitly Removed below then re-included; see Custom Types include block. -->
    <!-- Phase 5 stubs (preserve GUIDs so legacy .gh files load). -->
    <Compile Include="Components\UI Elements\CreateMultiShape_Component.cs" />
    <Compile Include="Components\UI Output\SetShapes_Component.cs" />
    <Compile Remove="Deprecated\**\*.cs" />
    <!-- Legacy hidden-Obsolete shims so historical .gh files resolve their old GUIDs
         without forcing an upgrade chain. Must come AFTER the bulk Remove so this
         Include wins in SDK-style item ordering. -->
    <Compile Include="Deprecated\CreatePullDown_Component_DEPRECATED.cs" />
    <Compile Include="Deprecated\CreatePullDown_Component_ALSO_DEPRECATED.cs" />
    <Compile Include="Deprecated\Legacy_BetaComponents_DEPRECATED.cs" />
    <Compile Remove="Components\UI Main\AdjustElementAppearance_Component.cs" />
    <Compile Remove="Components\UI Main\AdjustElementPositioning_Component.cs" />
    <Compile Remove="Components\UI Main\CaptureWindow_Component.cs" />
    <Compile Remove="Components\UI Main\CreateTransparentWindow_Component.cs" />
    <Compile Remove="Components\UI Main\GetElementProperties_Component.cs" />
    <Compile Remove="Components\UI Main\GetScreenDimensions_Component.cs" />
    <Compile Remove="Components\UI Main\HideShowElement_Component.cs" />
    <Compile Remove="Components\UI Main\MakeChildWindow_Component.cs" />
    <Compile Remove="Components\UI Main\RestoreElementState_Component.cs" />
    <Compile Remove="Components\UI Main\SaveElementState_Component.cs" />
    <Compile Remove="Components\UI Main\SetElementProperty_Component.cs" />
    <Compile Remove="Components\UI Main\SetWindowProperties_Component.cs" />
    <Compile Remove="Components\UI Main\WindowStatus_Component.cs" />
    <!-- Phase 3 UI Main entries (re-introduced from their Compile Remove just above). -->
    <Compile Include="Components\UI Main\AdjustElementPositioning_Component.cs" />
    <Compile Include="Components\UI Main\HideShowElement_Component.cs" />
    <Compile Remove="Custom Types\3DViewModel.cs" />
    <Compile Remove="Custom Types\ChartModel.cs" />
    <Compile Remove="Custom Types\ClickableShapeGrid.cs" />
    <Compile Remove="Custom Types\FilePicker.cs" />
    <Compile Remove="Custom Types\GradientHandle.cs" />
    <Compile Remove="Custom Types\GraphMapperElement.cs" />
    <Compile Remove="Custom Types\HUI_Gradient.cs" />
    <Compile Remove="Custom Types\HUI_GradientEditor.cs" />
    <Compile Remove="Custom Types\HUI_RhPickButton.cs" />
    <Compile Remove="Custom Types\MarkdownViewer.cs" />
    <Compile Remove="Custom Types\MDSliderElement.cs" />
    <Compile Remove="Custom Types\SliderEntryTextBox.cs" />
    <Compile Remove="Custom Types\StateSet_Goo.cs" />
    <Compile Remove="Custom Types\TrueOnlyButton.cs" />
    <!-- Phase 3 custom types. -->
    <Compile Include="Custom Types\FilePicker.cs" />
    <Compile Include="Custom Types\HUI_RhPickButton.cs" />
    <Compile Include="Custom Types\TrueOnlyButton.cs" />
    <!-- Phase 4 custom types. -->
    <Compile Include="Custom Types\MarkdownViewer.cs" />
  </ItemGroup>

  <!-- Emit a .gha alongside the .dll for Grasshopper packaging. -->
  <Target Name="CopyGhaFromDll" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(AssemblyName).gha" />
  </Target>

</Project>
